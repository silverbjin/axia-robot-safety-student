# AXIA D04 read-only Gazebo/ROS2 robot state (ROS 2 Jazzy RViz2).
# This file only contains displays and non-publishing view tools.
# Fixed Frame=odom: robust while robot is stationary; map/odom separate.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /LaserScan1
        - /RGB Camera1
        - /YOLO Debug Image1
      Splitter Ratio: 0.55
    Tree Height: 450
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.4
      Color: 160; 160; 160
      Cell Size: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      TF Prefix: ""
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.6
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 20
      Color: 0; 200; 255
      Shape: Arrow
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /odom
      Value: true
    - Class: rviz_default_plugins/Image
      Name: RGB Camera
      Enabled: true
      Normalize Range: true
      Median window: 5
      Min Value: 0
      Max Value: 1
      Transport Override: raw
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Name: YOLO Debug Image
      Enabled: true
      Normalize Range: true
      Median window: 5
      Min Value: 0
      Max Value: 1
      Transport Override: raw
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /yolo/cam0/debug_image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 35; 41
    Fixed Frame: odom
    Frame Rate: 20
  Name: D04 Robot State
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: base_link
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1530
  X: 50
  Y: 50
