# D07 sensor-first live Gazebo RViz2 profile. H01 optional Planner view is
# OFF until its actual live path visualization adapter is verified.
# NO_GOAL, NO final velocity publisher, no InitialPose/2D Goal tools.
# D04/D05 student scene uses visual-only Actor, not LiDAR physical human.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /LaserScan1
        - /Odometry1
      Splitter Ratio: 0.54
    Tree Height: 480
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.4
      Color: 160; 160; 160
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 16
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.45
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 245; 92; 72
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 30
      Color: 60; 190; 250
      Shape: Arrow
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /odom
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel (optional mesh)
      Enabled: false
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Value: true
    # In D04/D05/D08 student sensor-only runtime these official Nav2
    # topics are NOT provided. Leave them OFF rather than show blank red.
    # Instructor H01 run must explicitly prove live physical obstacle,
    # official Planner and Path relay before enabling either display.
    - Class: rviz_default_plugins/Map
      Name: H01 Official Global Costmap (not in student sensor-only scene)
      Enabled: false
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Path
      Name: H01 Official Planner Path (requires verified relay)
      Enabled: false
      Alpha: 1
      Color: 40; 255; 155
      Line Style: Lines
      Line Width: 0.06
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /axia/d07/h01/path_visual
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 34; 41
    Fixed Frame: odom
    Frame Rate: 15
  Name: D07 Read-Only Gazebo Sensor Observer
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.82
      Target Frame: base_footprint
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1450
  X: 40
  Y: 50
